[Unit]
Description=BronxBot System Tray
After=graphical-session.target
Wants=graphical-session.target
Requires=bronxbot.service

[Service]
Type=simple
WorkingDirectory=/home/ks/bronx-nextcord
Environment=PATH=/home/ks/bronx-venv/bin
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/home/ks/bronx-venv/bin/python /home/ks/bronx-nextcord/bronxbot_tray.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bronxbot-tray

[Install]
WantedBy=default.target
